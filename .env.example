# Copy to .env and fill in. Never commit .env.

# Supabase project URL (Project Settings -> API)
SUPABASE_URL=https://your-project-ref.supabase.co

# Server-side key: the service_role / secret key, NOT the anon/publishable key.
# Row Level Security is enabled on every table, so the anon key cannot read or write.
SUPABASE_KEY=your-service-role-key

# Flask session signing key. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me

# Set to 1 when serving over HTTPS (production)
SESSION_COOKIE_SECURE=0
